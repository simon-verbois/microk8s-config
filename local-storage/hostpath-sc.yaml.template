---
# Custom StorageClass for MicroK8s hostpath storage.
# Update the storage class name and local path before applying it.
kind: StorageClass
apiVersion: storage.k8s.io/v1
metadata:
  # Name used by PVCs with `storageClassName`.
  name: custom-hostpath
provisioner: microk8s.io/hostpath

# Delete the backing directory content when the PVC is removed.
# Change to `Retain` if you want to keep data after PVC deletion.
reclaimPolicy: Delete

parameters:
  # Local directory on the node where volumes will be created.
  pvDir: /path/to/your/microk8s-storage

# Wait until a Pod is scheduled before binding the volume.
volumeBindingMode: WaitForFirstConsumer
