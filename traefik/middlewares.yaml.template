---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: rate-limit
  namespace: traefik
spec:
  rateLimit:
    # Average number of requests per period before throttling.
    average: 200

    # Short burst capacity allowed above the average rate.
    burst: 150

    sourceCriterion:
      # Use the forwarded client IP when Traefik is behind a load balancer.
      requestHeaderName: "X-Forwarded-For"

---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: crowdsec-bouncer
  namespace: traefik
spec:
  plugin:
    crowdsec:
      enabled: true
      crowdsecLapiScheme: http
      crowdsecLapiHost: crowdsec-service.crowdsec.svc.cluster.local:8080

      # Replace with the bouncer key generated by CrowdSec LAPI.
      crowdsecLapiKey: "CHANGE_ME_WITH_CROWDSEC_LAPI_KEY"

      crowdsecMode: stream
      updateIntervalSeconds: 60

      # Keep traffic flowing if CrowdSec or the LAPI is temporarily unreachable.
      forwardIfClientOrLapiError: true

---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: compress
  namespace: traefik
spec:
  compress: {}

---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: whitelist
  namespace: traefik
spec:
  ipAllowList:
    sourceRange:
      # Replace with the public IPs or subnets allowed to access protected routes.
      - "203.0.113.10/32"
      - "198.51.100.0/24"

---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: geoblock
  namespace: traefik
spec:
  plugin:
    geoblock:
      api: "https://get.geojs.io/v1/ip/country/{ip}"
      apiTimeoutMs: 1500
      cacheSize: 500
      allowLocalRequests: true
      logLocalRequests: false
      logAllowedRequests: false
      logApiRequests: false
      silentStartUp: true
      allowUnknownCountries: false
      forceMonthlyUpdate: true

      # Set to `true` to block the countries listed below instead of allowing them.
      blackListMode: false

      countries:
        # Example allow list when `blackListMode` is false.
        - "BE"
        - "FR"
        - "LU"

---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: security-headers
  namespace: traefik
spec:
  headers:
    stsIncludeSubdomains: true
    stsPreload: true
    stsSeconds: 31536000
    contentTypeNosniff: true
    browserXssFilter: true
    customFrameOptionsValue: "SAMEORIGIN"
    customResponseHeaders:
      server: ""
      x-powered-by: ""
      Referrer-Policy: "strict-origin-when-cross-origin"
