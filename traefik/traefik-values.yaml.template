# Example Traefik Helm values for MicroK8s.
# # Official chart reference:
# # https://github.com/traefik/traefik-helm-chart/blob/master/traefik/values.yaml

env:
  - name: TZ
    value: Europe/Brussels

envFrom:
  - secretRef:
      name: ovh-credentials

providers:
  kubernetesCRD:
    enabled: true
    allowCrossNamespace: true
  kubernetesIngress:
    enabled: true
    publishedService:
      enabled: true

experimental:
  abortOnPluginFailure: true
  localPlugins:
    bouncer:
      moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
      mountPath: /plugins-local/src/github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      type: localPath
      volumeName: plugins
      subPath: src/github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
    geoblock:
      moduleName: "github.com/PascalMinder/geoblock"
      mountPath: /plugins-local/src/github.com/PascalMinder/geoblock
      type: localPath
      volumeName: plugins
      subPath: src/github.com/PascalMinder/geoblock

certificatesResolvers:
  ovhresolver:
    acme:
      email: admin@example.org
      storage: /data/acme.json
      dnsChallenge:
        provider: ovh
        propagation:
          delayBeforeChecks: 30

additionalArguments:
  - "--global.sendanonymoususage=false"
  - "--global.checknewversion=false"

ports:
  web:
    port: 8000
    exposedPort: 80
    protocol: TCP
    expose:
      default: true
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
    proxyProtocol:
      insecure: true

  websecure:
    port: 8443
    exposedPort: 443
    protocol: TCP
    expose:
      default: true
    proxyProtocol:
      insecure: true
    http:
      tls:
        enabled: true
        certResolver: ovhresolver

api:
  dashboard: false

logs:
  general:
    level: INFO
  access:
    enabled: true
    format: json

service:
  enabled: true
  single: true
  annotations:
    service.beta.kubernetes.io/metallb-loadbalancer-proxy-protocol: "*"
  spec:
    type: LoadBalancer
    externalTrafficPolicy: Local

additionalVolumeMounts:
  - name: geoblock-cache
    mountPath: /data/geoblock
  - name: plugins
    mountPath: /plugins-local

updateStrategy:
  type: Recreate

deployment:
  additionalVolumes:
    - name: geoblock-cache
      persistentVolumeClaim:
        claimName: traefik-geoblock-cache
    - name: plugins
      persistentVolumeClaim:
        claimName: traefik-plugins-pvc

  initContainers:
    - name: volume-permissions
      image: busybox:latest
      command:
        - sh
        - -c
        - touch /data/acme.json && chmod 600 /data/acme.json
      volumeMounts:
        - name: data
          mountPath: /data

    - name: download-local-plugins
      image: alpine/git:latest
      command:
        - sh
        - -c
        - |
          set -eu

          mkdir -p /plugins-local/src/github.com/maxlerebourg
          mkdir -p /plugins-local/src/github.com/PascalMinder

          rm -rf /plugins-local/src/github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
          rm -rf /plugins-local/src/github.com/PascalMinder/geoblock

          git clone --depth 1 --branch v1.5.1 \
            https://github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin.git \
            /plugins-local/src/github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin

          git clone --depth 1 --branch v0.3.7 \
            https://github.com/PascalMinder/geoblock.git \
            /plugins-local/src/github.com/PascalMinder/geoblock

          find /plugins-local/src/github.com -maxdepth 3 -type f -name go.mod -print
      volumeMounts:
        - name: plugins
          mountPath: /plugins-local

persistence:
  enabled: true
  path: /data
  size: 1Gi
  storageClass: hostpath-sc
