env:
  - name: TZ
    value: Europe/Brussels

envFrom:
  - secretRef:
      name: ovh-credentials

providers:
  kubernetesCRD:
    enabled: true
    allowCrossNamespace: true
  kubernetesIngress:
    enabled: true
    publishedService:
      enabled: true

experimental:
  abortOnPluginFailure: false
  localPlugins:
    crowdsec:
      moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      mountPath: /plugins-local/src/github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      type: localPath
      volumeName: traefik-plugins
    geoblock:
      moduleName: github.com/PascalMinder/geoblock
      mountPath: /plugins-local/src/github.com/PascalMinder/geoblock
      type: localPath
      volumeName: traefik-plugins

certificatesResolvers:
  ovhresolver:
    acme:
      email: admin@example.org
      storage: /data/acme.json
      dnsChallenge:
        provider: ovh
        propagation:
          delayBeforeChecks: 30

additionalArguments:
  - "--global.sendanonymoususage=false"
  - "--global.checknewversion=false"

ports:
  web:
    port: 8000
    exposedPort: 80
    protocol: TCP
    expose:
      default: true
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
    proxyProtocol:
      insecure: true

  websecure:
    port: 8443
    exposedPort: 443
    protocol: TCP
    expose:
      default: true
    proxyProtocol:
      insecure: true
    http:
      tls:
        enabled: true
        certResolver: ovhresolver

api:
  dashboard: false

logs:
  general:
    level: INFO
  access:
    enabled: true
    format: json
    filePath: /data/access.log

service:
  enabled: true
  single: true
  annotations:
    service.beta.kubernetes.io/metallb-loadbalancer-proxy-protocol: "*"
  spec:
    type: LoadBalancer
    externalTrafficPolicy: Local

deployment:
  strategy:
    type: Recreate
  additionalVolumes:
    - name: traefik-plugins
      persistentVolumeClaim:
        claimName: traefik-plugins
  initContainers:
    - name: volume-permissions
      image: busybox:latest
      command:
        - sh
        - -c
        - touch /data/acme.json && chmod 600 /data/acme.json
      volumeMounts:
        - name: data
          mountPath: /data

persistence:
  enabled: true
  path: /data
  size: 1Gi
  storageClass: hostpath-sc
